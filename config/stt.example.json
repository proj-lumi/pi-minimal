{
  "capture": {
    "type": "ffmpeg",
    "inputFormat": "alsa",
    "input": "hw:0",
    "sampleRate": 16000,
    "channels": 1,
    "maxSeconds": 120,
    "minBytes": 4096
  },
  "provider": {
    "type": "groq",
    "model": "whisper-large-v3-turbo",
    "language": "auto",
    "apiKeyFile": "~/.pi/agent/groq.key",
    "timeoutSeconds": 120
  },
  "output": {
    "appendTrailingSpace": true,
    "submitOnStop": false
  }
}